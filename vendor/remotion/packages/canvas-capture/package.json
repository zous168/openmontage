{
  "repository": {
    "url": "https://github.com/remotion-dev/remotion/tree/main/packages/canvas-capture"
  },
  "name": "@remotion/canvas-capture",
  "version": "4.0.484",
  "description": "Capture HTML-in-canvas content as a video",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/esm/index.mjs",
  "type": "module",
  "scripts": {
    "formatting": "oxfmt src --check",
    "format": "oxfmt src",
    "lint": "eslint src",
    "watch": "tsgo -w",
    "make": "tsgo && bun --env-file=../.env.bundle bundle.ts"
  },
  "author": "Jonny Burger <jonny@remotion.dev>",
  "contributors": [],
  "license": "Remotion License",
  "bugs": {
    "url": "https://github.com/remotion-dev/remotion/issues"
  },
  "dependencies": {
    "mediabunny": "1.52.2",
    "remotion": "4.0.484"
  },
  "peerDependencies": {
    "react": ">=16.8.0",
    "react-dom": ">=16.8.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "module": "./dist/esm/index.mjs",
      "import": "./dist/esm/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "remotion",
    "canvas-capture"
  ],
  "publishConfig": {
    "access": "public"
  }
}
